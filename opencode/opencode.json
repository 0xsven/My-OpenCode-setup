{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6.2-sol",
  "default_agent": "plan",
  "experimental": { "subagent_depth": 2 },
  "compaction": {
    "auto": true,
    "buffer": 32000,
    "keep": { "tokens": 15000 }
  },
  "agents": {
    "plan": {
      "permissions": [
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "gh pr view *", "effect": "allow" },
        { "action": "shell", "resource": "gh pr diff *", "effect": "allow" },
        { "action": "shell", "resource": "gh pr list *", "effect": "allow" },
        { "action": "shell", "resource": "gh pr checks *", "effect": "allow" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "quick-read", "effect": "allow" },
        { "action": "subagent", "resource": "general-read", "effect": "allow" },
        { "action": "subagent", "resource": "deep-read", "effect": "allow" }
      ]
    },
    "explore": {
      "disabled": true
    },
    "general": {
      "disabled": true
    },
    "compaction": {
      "model": "openai/gpt-6.2-sol#medium"
    }
  },
  "mcp": {
    "servers": {
      "datadog": {
        "type": "remote",
        "url": "https://mcp.datadoghq.com/v1/mcp"
      },
      "browse": {
        "type": "local",
        "command": ["{env:HOME}/.local/bin/browse", "mcp"],
        "cwd": "{env:HOME}",
        "environment": { "OPENCODE_BROWSER_RUNTIME": "auto-update" },
        "pool": true
      },
      "figma-mcp-desktop": {
        "type": "remote",
        "url": "http://127.0.0.1:3845/mcp"
      }
    }
  },
  "providers": {
    "openai": {
      "settings": {
        "reasoningEffort": "medium",
        "reasoningSummary": "auto",
        "textVerbosity": "low"
      },
      "body": {
        "include": ["reasoning.encrypted_content"],
        "store": false
      },
      "models": {
        "gpt-6.2-sol": {
          "name": "GPT 6.2 Sol (OAuth)",
          "limit": { "context": 272000, "input": 272000, "output": 128000 },
          "capabilities": { "input": ["text", "image"], "output": ["text"] }
        },
        "gpt-6-luna": {
          "name": "GPT 6 Luna (OAuth)",
          "limit": { "context": 272000, "input": 272000, "output": 128000 },
          "capabilities": { "input": ["text", "image"], "output": ["text"] }
        },
        "gpt-6.2-astra": {
          "name": "GPT 6.2 Astra (OAuth)",
          "limit": { "context": 272000, "input": 272000, "output": 128000 },
          "capabilities": { "input": ["text", "image"], "output": ["text"] }
        }
      }
    }
  }
}
